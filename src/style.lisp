(in-package :climish)

(defobject style ()
  :inputs
  ((display)
   (monitor)
   (monitor-width-mm (if (the monitor) (clui::monitor-width-mm (the monitor)) 320))
   (monitor-height-mm (if (the monitor) (clui::monitor-height-mm (the monitor)) 180))
   (monitor-video-mode (when (the monitor) (clui::get-monitor-video-mode (the monitor))))
   (monitor-width-px (if (the monitor-video-mode) (clui::video-mode-width (the monitor-video-mode)) 1024))
   (monitor-height-px (if (the monitor-video-mode) (clui::video-mode-height (the monitor-video-mode)) 768))
   (px-per-mm-width (/ (the monitor-width-px) (the monitor-width-mm)))
   (px-per-mm-height (/ (the monitor-height-px) (the monitor-height-mm)))
   
   (frame-border-size-mm 1/2)
   (frame-border-size (* (the frame-border-size-mm) (the px-per-mm-width)))
   (frame-padding-x-mm 1/4)
   (frame-padding-x (* (the frame-padding-x-mm) (the px-per-mm-width)))
   (frame-padding-y-mm 1/4)
   (frame-padding-y (* (the frame-padding-x-mm) (the px-per-mm-height)))
   (item-inner-spacing-x-mm 1/2)
   (item-inner-spacing-x (* (the item-inner-spacing-x-mm) (the px-per-mm-width)))
   (window-title-align-x-mm 1/4)
   (window-title-align-x (* (the window-title-align-x-mm) (the px-per-mm-width)))
   (window-menu-button-position :right)
   (title-bar-height-mm 4)
   ;;(title-bar-height (* (the title-bar-height-mm) (the px-per-mm-height)))
   (title-bar-height (* 3/2 (font-size (the current-font))))
   (default-window-border-size-mm 1/4)
   (default-window-border-size (* (the default-window-border-size-mm) (the px-per-mm-width)))
   (default-initial-window-height-mm 100)
   (default-initial-window-height (* (the default-initial-window-height-mm) (the px-per-mm-height)))
   (default-initial-window-width-mm 140)
   (default-initial-window-width (* (the default-initial-window-width-mm) (the px-per-mm-width)))
   
   (current-font (the roboto-font (bmfonts 3.5) bmfont))
   (lisp-defines-text-color #(0.545f0 0.980f0 0.439f0 1.0f0))
   (lisp-names-text-color #(0.888f0 0.814f0 0.310f0 1.0f0))
   (lisp-strings-color #(0.714f0 0.325f0 0.331f0 1.0f0))
   (lisp-&keywords-text-color #(0.549 0.769f0 1.0f0 1.0f0))
   (lisp-error-text-color #(1.0f0 0.278f0 0.255f0 1.0f0))
   (lisp-keywords-color #(0.878f0 0.565f0 0.843f0 1.0f0))
   (lisp-quote-color #(0.25f0 0.25f0 0.25f0 1.0f0))
   (lisp-comment-color #(0.305f0 0.474f0 0.960f0 1.0f0)))

  :components
  ((roboto-font :type 'font
		ttf-file (asdf/system:system-relative-pathname
			  :krma "submodules/krma-fonts/Roboto_Mono/static/RobotoMono-Medium.ttf")
		style self)))

(defobject font ()
  :inputs
  ((style)
   (ttf-file)
   (font-sizes `((2) (2.5) (2.75) (3) (3.5) (4) (4.5) (5))))

  :components
  ((bmfonts :type 'bmfont
	    :aggregate (:indices (the font-sizes))
	    style (the style)
	    font self
	    px-per-mm (the style px-per-mm-height))))

(defobject bmfont ()
  :inputs
  ((style)
   (px-per-mm))
  
  :attributes
  ((mm-size (the index))
   (px-size (round (* (the mm-size) (the px-per-mm))))
   (cache-filename (asdf/system:system-relative-pathname :krma (concatenate 'string "submodules/krma-fonts/"
									    (pathname-name (the font ttf-file))
									    "-"
									    (format nil "~A" (the px-size))
									    ".json")))
   (bmfont (maybe-update-cache self))))

(defmethod print-object ((object bmfont) stream)
  (print-unreadable-object (object stream)
    (princ "BMFONT" stream)))

(defmethod maybe-update-cache ((self bmfont))
  (let ((cache-filename (the cache-filename)))
    (unless (probe-file cache-filename)
      (sdf-bmfont:create-bmfont (the font ttf-file)
				cache-filename
				:size (max (the px-size) 1)
				:mode :msdf+a
				:type :json
				:spread 8))
    (let* ((dpy (the style display))
	   (device (vk::default-logical-device dpy))
	   (index (vk::queue-family-index (vk::render-surface (clui::helper-window dpy))))
	   (queue (vk::find-queue device index))
	   (sampler (krma::krma-texture-sampler (the style display)))
	   (texture-dsl (vk::create-descriptor-set-layout
			 device
			 :bindings (list (make-instance 'vk::descriptor-set-layout-binding
							:type vk::VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER
							:count 1
							:flags vk::VK_SHADER_STAGE_FRAGMENT_BIT
							:samplers (list sampler)))))
	   (command-pool (vk::find-command-pool device index))
	   (descriptor-pool (vk::default-descriptor-pool dpy))
	   (command-buffer (elt (vk::command-buffers command-pool) 0)))
	  
      (krma::vulkan-make-font device queue sampler texture-dsl descriptor-pool command-buffer :cache-file cache-filename))))
			    
									    





(defun saturate (float)
  (when (minusp float) (return-from saturate 0.0f0))
  (when (> float 1.0f0) (return-from saturate 1.0f0))
  float)

